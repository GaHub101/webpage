{
  "name": "kfo-praxis-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && npm run build && npm run test",
    "test": "npm run test:html && npm run test:links && npm run test:csp && npm run test:browser",
    "test:html": "html-validate \"dist/**/*.html\"",
    "test:links": "node scripts/check-links.mjs dist",
    "test:csp": "node scripts/check-csp.mjs dist",
    "test:browser": "node scripts/test-browser.mjs dist",
    "placeholders": "node scripts/generate-placeholders.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "^7.3.5",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "html-validate": "^11.16.1",
    "playwright": "1.63.0"
  }
}
