# Infomaniak / Apache: Sicherheits-Header, HTTPS, Fehlerseite, Weiterleitungen alter URLs.
# Wird beim Build mit PUBLIC_FORM_MODE=php nach dist/.htaccess kopiert.

ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS erzwingen
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www → ohne www (TODO: anpassen, falls die www-Variante die Hauptadresse sein soll)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Alte URLs der bisherigen Website
  RewriteRule ^unsere-leistungen/behandlungsangebot/?$ /leistungen/behandlungsangebot/ [L,R=301]
  RewriteRule ^unsere-leistungen/unsichtbare-zahnspangen/?$ /leistungen/unsichtbare-zahnspangen/ [L,R=301]
  RewriteRule ^unsere-leistungen/unsere-standards/?$ /leistungen/unsere-standards/ [L,R=301]
  RewriteRule ^unsere-leistungen/der-erste-termin/?$ /leistungen/der-erste-termin/ [L,R=301]
  RewriteRule ^unsere-leistungen/notfalle/?$ /leistungen/notfaelle/ [L,R=301]
  RewriteRule ^unsere-leistungen/?$ /leistungen/behandlungsangebot/ [L,R=301]
  RewriteRule ^haufige-fragen/?$ /haeufige-fragen/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set X-Frame-Options "DENY"
  # Ergänzt die CSP im <meta>-Tag jeder Seite (frame-ancestors geht nur als Header)
  Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Lange Cache-Dauer nur für Dateien mit Hash im Namen (Ordner /_astro/)
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Konfigurationsdateien niemals ausliefern
<FilesMatch "^(contact-config\.php|\.env.*)$">
  Require all denied
</FilesMatch>
