---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

const oeffnungszeiten = [
  { tag: 'Montag',      zeit: '08:00 – 18:00 Uhr' },
  { tag: 'Dienstag',    zeit: '08:00 – 18:00 Uhr' },
  { tag: 'Mittwoch',    zeit: '08:00 – 13:00 Uhr' },
  { tag: 'Donnerstag',  zeit: '08:00 – 18:00 Uhr' },
  { tag: 'Freitag',     zeit: '08:00 – 14:00 Uhr' },
  { tag: 'Samstag',     zeit: 'Geschlossen' },
  { tag: 'Sonntag',     zeit: 'Geschlossen' },
];
---

<BaseLayout
  title="Kontakt & Terminanfrage – KFO Praxis Dr. Müller Musterstadt"
  description="Kontaktieren Sie die KFO Praxis Dr. Müller in Musterstadt. Terminanfrage, Öffnungszeiten, Adresse und Anfahrt — wir freuen uns auf Sie."
>
  <Header />
  <main>

    <!-- Page Hero -->
    <section class="bg-gradient-to-br from-primary-900 to-primary-700 py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl lg:text-5xl font-extrabold text-white">Kontakt</h1>
        <p class="mt-4 text-lg text-primary-200 max-w-xl mx-auto">
          Vereinbaren Sie Ihre kostenlose Erstberatung oder stellen Sie uns gerne Ihre Fragen.
        </p>
      </div>
    </section>

    <section class="bg-white py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-14">

          <!-- Contact Form -->
          <div>
            <h2 class="text-2xl font-extrabold text-primary-900 mb-2">Terminanfrage</h2>
            <p class="text-slate-500 text-sm mb-8">Füllen Sie das Formular aus — wir melden uns innerhalb von 24 Stunden bei Ihnen.</p>

            <form
              name="terminanfrage"
              method="POST"
              data-netlify="true"
              netlify-honeypot="bot-field"
              action="/danke"
              class="space-y-5"
            >
              <!-- Honeypot -->
              <input type="hidden" name="form-name" value="terminanfrage" />
              <div class="hidden" aria-hidden="true">
                <label>Nicht ausfüllen: <input name="bot-field" /></label>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="vorname" class="block text-sm font-semibold text-slate-700 mb-1.5">Vorname *</label>
                  <input
                    type="text"
                    id="vorname"
                    name="vorname"
                    required
                    autocomplete="given-name"
                    class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition"
                    placeholder="Max"
                  />
                </div>
                <div>
                  <label for="nachname" class="block text-sm font-semibold text-slate-700 mb-1.5">Nachname *</label>
                  <input
                    type="text"
                    id="nachname"
                    name="nachname"
                    required
                    autocomplete="family-name"
                    class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition"
                    placeholder="Mustermann"
                  />
                </div>
              </div>

              <div>
                <label for="email" class="block text-sm font-semibold text-slate-700 mb-1.5">E-Mail-Adresse *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition"
                  placeholder="max@beispiel.de"
                />
              </div>

              <div>
                <label for="telefon" class="block text-sm font-semibold text-slate-700 mb-1.5">Telefon</label>
                <input
                  type="tel"
                  id="telefon"
                  name="telefon"
                  autocomplete="tel"
                  class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition"
                  placeholder="+49 123 456 789"
                />
              </div>

              <div>
                <label for="anliegen" class="block text-sm font-semibold text-slate-700 mb-1.5">Anliegen</label>
                <select
                  id="anliegen"
                  name="anliegen"
                  class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition bg-white"
                >
                  <option value="">Bitte wählen…</option>
                  <option>Kostenlose Erstberatung</option>
                  <option>Fragen zu Leistungen</option>
                  <option>Fragen zu Kosten & Kasse</option>
                  <option>Terminänderung</option>
                  <option>Sonstiges</option>
                </select>
              </div>

              <div>
                <label for="nachricht" class="block text-sm font-semibold text-slate-700 mb-1.5">Nachricht</label>
                <textarea
                  id="nachricht"
                  name="nachricht"
                  rows="4"
                  class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition resize-none"
                  placeholder="Ihre Nachricht an uns…"
                ></textarea>
              </div>

              <div class="flex items-start gap-3">
                <input
                  type="checkbox"
                  id="datenschutz"
                  name="datenschutz"
                  required
                  class="mt-0.5 w-4 h-4 rounded border-slate-300 text-primary-600 focus:ring-primary-500"
                />
                <label for="datenschutz" class="text-xs text-slate-500 leading-relaxed">
                  Ich habe die <a href="/datenschutz" class="text-primary-600 hover:underline">Datenschutzerklärung</a> gelesen und stimme der Verarbeitung meiner Daten zur Bearbeitung meiner Anfrage zu. *
                </label>
              </div>

              <button
                type="submit"
                class="w-full bg-primary-600 hover:bg-primary-700 text-white font-semibold py-3.5 rounded-xl transition-colors shadow-sm flex items-center justify-center gap-2"
              >
                Anfrage senden
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
              </button>

              <p class="text-xs text-slate-400 text-center">* Pflichtfelder. Wir antworten innerhalb von 24 Stunden.</p>
            </form>
          </div>

          <!-- Contact Info -->
          <div class="space-y-8">
            <div>
              <h2 class="text-2xl font-extrabold text-primary-900 mb-6">Kontaktdaten</h2>
              <div class="space-y-4">
                {[
                  { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />`, label: 'Adresse', value: 'Musterstraße 1, 12345 Musterstadt', href: undefined },
                  { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />`, label: 'Telefon', value: '+49 123 456 78 0', href: 'tel:+491234567890' },
                  { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`, label: 'E-Mail', value: 'info@kfo-muster.de', href: 'mailto:info@kfo-muster.de' },
                ].map(({ icon, label, value, href }) => (
                  <div class="flex items-start gap-4">
                    <div class="w-10 h-10 bg-primary-50 rounded-xl flex items-center justify-center shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={icon} />
                    </div>
                    <div>
                      <div class="text-xs text-slate-400 font-medium uppercase tracking-wide mb-0.5">{label}</div>
                      {href ? (
                        <a href={href} class="text-sm text-slate-700 font-medium hover:text-primary-600 transition-colors">{value}</a>
                      ) : (
                        <span class="text-sm text-slate-700 font-medium">{value}</span>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Öffnungszeiten -->
            <div class="bg-primary-50 rounded-2xl p-6">
              <h3 class="font-bold text-primary-900 mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Öffnungszeiten
              </h3>
              <div class="space-y-2">
                {oeffnungszeiten.map(({ tag, zeit }) => (
                  <div class="flex justify-between text-sm">
                    <span class="text-slate-600 font-medium">{tag}</span>
                    <span class={zeit === 'Geschlossen' ? 'text-slate-400' : 'text-slate-700'}>{zeit}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Trust -->
            <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-5">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-emerald-100 rounded-lg flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <p class="text-sm text-emerald-800 font-medium">
                  Kostenlose Erstberatung ohne Verpflichtung — Kassenpatienten & Privatpatienten willkommen.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
