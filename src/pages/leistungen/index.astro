---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import CtaBlock from '@/components/sections/CtaBlock.astro';

const leistungen = [
  {
    id: 'aligner',
    title: 'Unsichtbare Aligner',
    subtitle: 'Diskrete Korrektur ohne Brackets',
    description: 'Transparente, herausnehmbare Kunststoffschienen korrigieren Zahnfehlstellungen nahezu unsichtbar. Ideal für Erwachsene und Jugendliche, die ihre Zähne unauffällig begradigen möchten. Die Schienen werden alle ein bis zwei Wochen gewechselt und passen sich dem Behandlungsfortschritt an.',
    vorteile: ['Kaum sichtbar im Alltag', 'Herausnehmbar zum Essen & Putzen', 'Weniger Zahnarztbesuche nötig', 'Kein Metall, weniger Reizungen'],
    geeignet: 'Jugendliche & Erwachsene',
    dauer: '6–24 Monate',
    farbe: 'accent',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />`,
  },
  {
    id: 'feste-spange',
    title: 'Feste Zahnspange',
    subtitle: 'Die bewährte Allroundmethode',
    description: 'Die Multibandapparatur (Brackets mit Bogen) ist die bewährteste Methode in der Kieferorthopädie und ermöglicht präzise Korrekturen auch bei komplexen Fehlstellungen. Wir bieten metallische und keramische (zahnfarbene) Brackets an.',
    vorteile: ['Ideal für alle Schweregrade', 'Präzise und effizient', 'Keramik-Option (zahnfarben)', 'Für Kinder, Jugendliche & Erwachsene'],
    geeignet: 'Alle Altersgruppen',
    dauer: '12–30 Monate',
    farbe: 'primary',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18" />`,
  },
  {
    id: 'herausnehmbare-spange',
    title: 'Herausnehmbare Spange',
    subtitle: 'Flexibel & komfortabel',
    description: 'Abnehmbare Apparaturen werden vor allem in der Frühbehandlung und bei Kindern eingesetzt. Sie können zum Zähneputzen und beim Sport herausgenommen werden und eignen sich ideal, um das Kieferwachstum zu beeinflussen.',
    vorteile: ['Ideal für Kinder', 'Herausnehmbar', 'Fördert korrektes Kieferwachstum', 'Schonend & einfach zu handhaben'],
    geeignet: 'Kinder & Jugendliche',
    dauer: '6–18 Monate',
    farbe: 'violet',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />`,
  },
  {
    id: 'fruehbehandlung',
    title: 'Frühbehandlung',
    subtitle: 'Früh erkannt — leichter behandelt',
    description: 'Ab dem 6. Lebensjahr können Kieferfehlstellungen und Zahnengstände frühzeitig erkannt und mit einfacheren Mitteln korrigiert werden. Eine rechtzeitige Behandlung kann spätere, aufwändigere Eingriffe vermeiden.',
    vorteile: ['Einfachere Behandlung im Kleinkindalter', 'Kann spätere Eingriffe verhindern', 'Frühe Kontrolle des Kieferwachstums', 'Stärkt das Selbstbewusstsein früh'],
    geeignet: 'Kinder ab 6 Jahren',
    dauer: 'Individuell',
    farbe: 'emerald',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />`,
  },
  {
    id: 'erwachsenen-kfo',
    title: 'Erwachsenen-KFO',
    subtitle: 'Niemals zu spät',
    description: 'Immer mehr Erwachsene entscheiden sich für eine kieferorthopädische Behandlung — sei es aus ästhetischen oder gesundheitlichen Gründen. Mit modernen Methoden wie Alignern oder keramischen Brackets ist die Behandlung diskret und komfortabel.',
    vorteile: ['Ästhetische und diskrete Methoden', 'Keine Altersbegrenzung', 'Verbessert auch Kaufunktion & Aussprache', 'Kassenleistung bei medizinischer Indikation'],
    geeignet: 'Erwachsene',
    dauer: '12–36 Monate',
    farbe: 'orange',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />`,
  },
  {
    id: 'retention',
    title: 'Retention & Nachsorge',
    subtitle: 'Das Ergebnis dauerhaft sichern',
    description: 'Nach dem Abschluss der aktiven Behandlung ist die Retention entscheidend: Herausnehmbare oder festgeklebte Retainer verhindern, dass die Zähne in ihre alte Position zurückkehren. Regelmäßige Kontrolltermine sichern das Ergebnis langfristig.',
    vorteile: ['Festgeklebte oder herausnehmbare Retainer', 'Langfristige Ergebnissicherung', 'Regelmäßige Kontrollen', 'Persönliche Nachsorge & Beratung'],
    geeignet: 'Nach jeder Behandlung',
    dauer: 'Dauerhaft',
    farbe: 'rose',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
  },
];
---

<BaseLayout
  title="Leistungen – KFO Praxis Dr. Müller Musterstadt"
  description="Unsere kieferorthopädischen Leistungen: Unsichtbare Aligner, feste & herausnehmbare Spangen, Frühbehandlung, Erwachsenen-KFO und Retention. Für jedes Alter."
>
  <Header />
  <main>

    <!-- Page Hero -->
    <section class="bg-gradient-to-br from-primary-900 to-primary-700 py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl lg:text-5xl font-extrabold text-white">Unsere Leistungen</h1>
        <p class="mt-4 text-lg text-primary-200 max-w-2xl mx-auto">
          Moderne Kieferorthopädie für jedes Alter — individuell, schonend und auf Ihre Bedürfnisse abgestimmt.
        </p>
      </div>
    </section>

    <!-- Leistungen Detail -->
    <section class="bg-white py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="space-y-16">
          {leistungen.map(({ title, subtitle, description, vorteile, geeignet, dauer, icon }, i) => (
            <div class={`grid grid-cols-1 lg:grid-cols-2 gap-10 items-center ${i % 2 !== 0 ? 'lg:flex-row-reverse' : ''}`}>
              <!-- Visual side -->
              <div class={`${i % 2 !== 0 ? 'lg:order-2' : ''}`}>
                <div class="bg-primary-50 rounded-3xl p-10 flex items-center justify-center aspect-square max-w-sm mx-auto lg:max-w-none">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-32 h-32 text-primary-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" set:html={icon} />
                </div>
              </div>
              <!-- Text side -->
              <div class={`${i % 2 !== 0 ? 'lg:order-1' : ''}`}>
                <p class="text-accent-600 text-sm font-semibold uppercase tracking-widest mb-2">{subtitle}</p>
                <h2 class="text-2xl lg:text-3xl font-extrabold text-primary-900 mb-4">{title}</h2>
                <p class="text-slate-500 leading-relaxed mb-6">{description}</p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
                  {vorteile.map(v => (
                    <div class="flex items-start gap-2 text-sm text-slate-700">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-accent-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      {v}
                    </div>
                  ))}
                </div>

                <div class="flex flex-wrap gap-3 mb-7">
                  <div class="bg-primary-50 text-primary-700 text-xs font-semibold px-3 py-1.5 rounded-full">
                    Geeignet für: {geeignet}
                  </div>
                  <div class="bg-accent-50 text-accent-700 text-xs font-semibold px-3 py-1.5 rounded-full">
                    Behandlungsdauer: {dauer}
                  </div>
                </div>

                <a href="/kontakt" class="inline-flex items-center gap-2 bg-primary-600 hover:bg-primary-700 text-white font-semibold px-6 py-3 rounded-xl transition-colors shadow-sm">
                  Beratung anfragen
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <CtaBlock />
  </main>
  <Footer />
</BaseLayout>
