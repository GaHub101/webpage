---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import PageLayout from '../../../layouts/PageLayout.astro';
import EmergencyBox from '../../../components/EmergencyBox.astro';
import Steps from '../../../components/Steps.astro';
import OpeningHours from '../../../components/OpeningHours.astro';
import Icon from '../../../components/Icon.astro';
import { site } from '../../../config/site';
import { nbsp } from '../../../lib/format';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  const all = (await getCollection('leistungen')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}

interface Props {
  entry: CollectionEntry<'leistungen'>;
  all: CollectionEntry<'leistungen'>[];
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<PageLayout title={d.title} description={d.description} lead={d.lead} eyebrow="Unsere Leistungen" image={d.image}>
  <div class="service">
    <article class="service__main">
      {d.emergency && <EmergencyBox />}
      {d.steps && <Steps steps={d.steps} title="So läuft der erste Termin ab" />}
      {
        d.image && d.imageAlt && (
          <Picture
            src={d.image}
            alt={d.imageAlt}
            class="service__img"
            widths={[480, 800, 1200]}
            sizes="(min-width: 64rem) 760px, 100vw"
            formats={['avif', 'webp']}
          />
        )
      }
      <div class="prose">
        <Content />
      </div>
    </article>

    <aside class="service__aside" aria-label="Weitere Leistungen und Kontakt">
      <nav class="subnav" aria-labelledby="subnav-title">
        <h2 id="subnav-title" class="subnav__title">Unsere Leistungen</h2>
        <ul>
          {
            all.map((l) => (
              <li>
                <a href={url(`/leistungen/${l.id}/`)} aria-current={l.id === entry.id ? 'page' : undefined}>
                  {l.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="aside-card">
        <h2 class="subnav__title">Fragen? Rufen Sie uns an.</h2>
        <a class="aside-card__phone" href={`tel:${site.phone.tel}`}>
          <Icon name="phone" size={20} />
          {nbsp(site.phone.display)}
        </a>
        <OpeningHours caption="Telefonisch erreichbar" hours={site.phoneHours} variant="footer" />
      </div>
    </aside>
  </div>
</PageLayout>

<style>
  .service {
    display: grid;
    gap: var(--sp-6);
  }

  @media (min-width: 64rem) {
    .service {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: var(--sp-8);
    }

    .service__aside {
      position: sticky;
      top: calc(var(--header-h-compact) + var(--sp-3));
      align-self: start;
    }
  }

  .service__main :global(.service__img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--r-lg);
    margin-bottom: var(--sp-5);
  }

  .service__aside {
    display: grid;
    gap: var(--sp-3);
  }

  .subnav,
  .aside-card {
    padding: var(--sp-3);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    background: var(--c-surface);
  }

  .subnav__title {
    font-size: 1rem;
    margin-bottom: var(--sp-1);
  }

  .subnav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .subnav a {
    display: block;
    padding: 0.55rem 0.75rem;
    margin-inline: -0.75rem;
    border-radius: var(--r-sm);
    color: var(--c-text);
    text-decoration: none;
    font-weight: var(--fw-medium);
  }

  .subnav a:hover {
    background: var(--c-bg-warm);
    color: var(--c-primary-strong);
  }

  .subnav a[aria-current='page'] {
    background: var(--c-primary-soft);
    color: var(--c-primary-strong);
    font-weight: var(--fw-bold);
  }

  .aside-card {
    background: var(--c-bg-warm);
  }

  .aside-card__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--sp-2);
    font-size: 1.375rem;
    font-weight: var(--fw-bold);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  .aside-card :global(caption) {
    font-size: var(--fs-sm);
  }
</style>
