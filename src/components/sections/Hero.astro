---
---

<section class="relative overflow-hidden bg-gradient-to-br from-primary-900 via-primary-800 to-primary-700">
  <!-- Background decoration -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-accent-500/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-20 -left-20 w-72 h-72 bg-primary-600/30 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Text Content -->
      <div>
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 bg-accent-500/20 text-accent-300 text-xs font-semibold px-3 py-1.5 rounded-full mb-6 border border-accent-500/30">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
          </svg>
          Fachpraxis für Kieferorthopädie
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight tracking-tight">
          Ihr perfektes<br />
          <span class="text-accent-400">Lächeln</span> beginnt hier
        </h1>

        <p class="mt-6 text-lg text-primary-200 leading-relaxed max-w-lg">
          Als Ihre Fachpraxis für Kieferorthopädie begleiten wir Sie von der ersten Beratung bis zum strahlenden Ergebnis — für Kinder, Jugendliche und Erwachsene.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a
            href="/kontakt"
            class="inline-flex items-center justify-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-semibold text-base px-7 py-3.5 rounded-xl transition-colors shadow-lg"
          >
            Kostenlose Erstberatung
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="/referenzen"
            class="inline-flex items-center justify-center gap-2 border-2 border-white/30 hover:border-white/60 text-white font-semibold text-base px-7 py-3.5 rounded-xl transition-colors"
          >
            Vorher / Nachher
          </a>
        </div>

        <!-- Trust micro-signals -->
        <div class="mt-10 flex flex-wrap gap-6 text-sm text-primary-200">
          <div class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Kassenpatienten willkommen
          </div>
          <div class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Modernste Technik
          </div>
          <div class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Flexible Terminvergabe
          </div>
        </div>
      </div>

      <!-- Visual -->
      <div class="flex justify-center lg:justify-end">
        <div class="relative">
          <!-- Main illustration card -->
          <div class="w-80 h-80 lg:w-96 lg:h-96 bg-white/10 backdrop-blur-sm rounded-3xl border border-white/20 flex items-center justify-center">
            <svg viewBox="0 0 200 200" class="w-56 h-56 opacity-90" xmlns="http://www.w3.org/2000/svg">
              <!-- Smile arc -->
              <circle cx="100" cy="100" r="80" fill="none" stroke="white" stroke-width="2" opacity="0.2"/>
              <!-- Teeth row -->
              <g fill="white">
                <rect x="52" y="80" width="14" height="22" rx="4"/>
                <rect x="70" y="76" width="16" height="26" rx="4"/>
                <rect x="90" y="74" width="18" height="28" rx="5"/>
                <rect x="112" y="74" width="18" height="28" rx="5"/>
                <rect x="134" y="76" width="16" height="26" rx="4"/>
                <rect x="154" y="80" width="14" height="22" rx="4"/>
              </g>
              <!-- Smile curve line below teeth -->
              <path d="M52 104 Q100 130 168 104" fill="none" stroke="#06b6d4" stroke-width="3" stroke-linecap="round"/>
              <!-- Aligner overlay (transparent) -->
              <path d="M48 78 Q100 68 172 78 L172 106 Q100 116 48 106 Z" fill="none" stroke="#a5f3fc" stroke-width="1.5" stroke-dasharray="4,3" opacity="0.6"/>
            </svg>
          </div>

          <!-- Floating stat cards -->
          <div class="absolute -top-4 -left-6 bg-white rounded-2xl shadow-xl px-4 py-3 flex items-center gap-3">
            <div class="w-10 h-10 bg-accent-50 rounded-xl flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <div class="text-xl font-bold text-primary-900">500+</div>
              <div class="text-xs text-slate-500">Patienten</div>
            </div>
          </div>

          <div class="absolute -bottom-4 -right-6 bg-white rounded-2xl shadow-xl px-4 py-3 flex items-center gap-3">
            <div class="w-10 h-10 bg-primary-50 rounded-xl flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
              </svg>
            </div>
            <div>
              <div class="text-xl font-bold text-primary-900">15 J.</div>
              <div class="text-xs text-slate-500">Erfahrung</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
