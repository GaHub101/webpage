---
const highlights = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />`,
    label: 'Herzlich & einfühlsam',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />`,
    label: 'Modernste Technik',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />`,
    label: 'Fachlich zertifiziert',
  },
];
---

<section class="bg-white py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Visual -->
      <div class="relative order-2 lg:order-1">
        <div class="aspect-square max-w-md mx-auto bg-gradient-to-br from-primary-100 to-accent-100 rounded-3xl flex items-center justify-center">
          <!-- Placeholder illustration -->
          <svg viewBox="0 0 240 240" class="w-56 h-56" xmlns="http://www.w3.org/2000/svg">
            <!-- Doctor figure, simplified -->
            <circle cx="120" cy="70" r="40" fill="#bfdbfe"/>
            <!-- Body -->
            <rect x="80" y="120" width="80" height="90" rx="12" fill="#1d4ed8" opacity="0.8"/>
            <!-- Stethoscope -->
            <path d="M100 140 Q90 155 90 170 Q90 185 105 185 Q120 185 120 170 Q120 155 130 140" fill="none" stroke="#06b6d4" stroke-width="4" stroke-linecap="round"/>
            <circle cx="105" cy="185" r="8" fill="#06b6d4"/>
            <!-- Face smile -->
            <circle cx="108" cy="65" r="6" fill="white" opacity="0.8"/>
            <circle cx="132" cy="65" r="6" fill="white" opacity="0.8"/>
            <path d="M108 82 Q120 92 132 82" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" opacity="0.9"/>
          </svg>
        </div>

        <!-- Floating card -->
        <div class="absolute bottom-8 -right-4 lg:right-4 bg-white rounded-2xl shadow-xl px-5 py-4 max-w-48">
          <div class="text-xs text-slate-400 font-medium mb-1">Nächster freier Termin</div>
          <div class="text-base font-bold text-primary-800">Heute anfragen</div>
          <div class="flex items-center gap-1 mt-1.5">
            <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
            <span class="text-xs text-emerald-600 font-medium">Praxis geöffnet</span>
          </div>
        </div>
      </div>

      <!-- Text -->
      <div class="order-1 lg:order-2">
        <div class="inline-flex items-center gap-2 text-accent-600 text-sm font-semibold mb-4 uppercase tracking-widest">
          <span class="block w-6 h-px bg-accent-500"></span>
          Über uns
        </div>

        <h2 class="text-3xl lg:text-4xl font-extrabold text-primary-900 leading-tight">
          Erfahren, engagiert<br /> und nah am Patienten
        </h2>

        <p class="mt-5 text-slate-500 leading-relaxed">
          Dr. med. dent. Maria Müller und ihr Team begleiten Patienten jeden Alters mit Fachwissen, Empathie und einem Blick für das Wesentliche: Ihr perfektes Lächeln.
        </p>
        <p class="mt-4 text-slate-500 leading-relaxed">
          Seit über 15 Jahren ist unsere Praxis in Musterstadt eine vertrauensvolle Anlaufstelle für Kinder, Jugendliche und Erwachsene, die ihre Zahnstellung verbessern möchten.
        </p>

        <div class="mt-7 space-y-3">
          {highlights.map(({ icon, label }) => (
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 bg-primary-50 rounded-lg flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={icon} />
              </div>
              <span class="text-slate-700 font-medium text-sm">{label}</span>
            </div>
          ))}
        </div>

        <div class="mt-8">
          <a href="/ueber-uns" class="inline-flex items-center gap-2 border-2 border-primary-600 text-primary-700 hover:bg-primary-50 font-semibold px-6 py-3 rounded-xl transition-colors">
            Unser Team kennenlernen
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
