---
const stats = [
  { value: '500+', label: 'Zufriedene Patienten' },
  { value: '15',   label: 'Jahre Erfahrung'      },
  { value: '6',    label: 'Behandlungsmethoden'  },
  { value: '98%',  label: 'Weiterempfehlungsrate' },
];

const badges = [
  'Kassenpatienten & Privatpatienten',
  'Zertifizierte Kieferorthopädin',
  'Digitale 3D-Diagnostik',
  'Schmerzarme Behandlung',
];
---

<section class="bg-primary-50 border-y border-primary-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Stats row -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
      {stats.map(({ value, label }) => (
        <div class="text-center">
          <div class="text-3xl lg:text-4xl font-extrabold text-primary-800">{value}</div>
          <div class="text-sm text-slate-500 mt-1 font-medium">{label}</div>
        </div>
      ))}
    </div>

    <!-- Trust badges -->
    <div class="flex flex-wrap justify-center gap-3">
      {badges.map(badge => (
        <div class="flex items-center gap-2 bg-white border border-primary-100 text-slate-700 text-sm font-medium px-4 py-2 rounded-full shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-accent-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          {badge}
        </div>
      ))}
    </div>
  </div>
</section>
