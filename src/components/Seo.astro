---
import { site } from '../config/site';
import { env } from '../config/env';
import { toOpeningHoursSpec } from '../lib/hours';
import { url } from '../lib/url';
import ogDefault from '../assets/images/og-default.jpg';
import { getImage } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  noindex?: boolean;
}

const { title, description = site.description, image = ogDefault, noindex = false } = Astro.props;
const fullTitle = title ? `${title} – ${site.shortName}` : `${site.name} – ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: image, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const ogUrl = new URL(og.src, Astro.site);
const robotsNoindex = env.noindex || noindex;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  '@id': new URL(url('/#praxis'), Astro.site).href,
  name: site.name,
  description: site.description,
  url: new URL(url('/'), Astro.site).href,
  telephone: site.phone.tel,
  email: site.email,
  image: ogUrl.href,
  medicalSpecialty: 'Orthodontic',
  foundingDate: String(site.foundingYear),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.zip,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.maps.geo.lat, longitude: site.maps.geo.lng },
  openingHoursSpecification: toOpeningHoursSpec(site.openingHours),
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{robotsNoindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="de_CH" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogUrl.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
