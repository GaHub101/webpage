---
import { Picture } from 'astro:assets';
import { url } from '../lib/url';
import Icon from './Icon.astro';

interface Props {
  title: string;
  text: string;
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  headingLevel?: 'h2' | 'h3';
}

const { title, text, href, image, imageAlt, headingLevel: H = 'h3' } = Astro.props;
---

<article class="teaser">
  <div class="teaser__media">
    <Picture src={image} alt={imageAlt} widths={[400, 640, 800]} sizes="(min-width: 64rem) 380px, (min-width: 40rem) 50vw, 100vw" formats={['avif', 'webp']} />
  </div>
  <div class="teaser__body">
    <H class="teaser__title">
      <a href={url(href)}>{title}</a>
    </H>
    <p>{text}</p>
    <span class="teaser__more" aria-hidden="true">Mehr erfahren <Icon name="arrowRight" size={18} /></span>
  </div>
</article>

<style>
  .teaser {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .teaser:hover,
  .teaser:focus-within {
    background: var(--c-surface-hover);
    border-color: var(--c-primary);
  }

  .teaser__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .teaser__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .teaser__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--sp-3);
  }

  .teaser__title {
    font-size: var(--fs-h3);
    margin-bottom: var(--sp-1);
  }

  .teaser__title a {
    color: var(--c-text);
    text-decoration: none;
  }

  /* Ganze Kachel klickbar, ein einziger Link für Screenreader */
  .teaser__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .teaser__title a:focus-visible {
    outline: none;
  }

  .teaser:has(a:focus-visible) {
    outline: 3px solid var(--c-focus);
    outline-offset: 3px;
  }

  .teaser p {
    color: var(--c-text-muted);
  }

  .teaser__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    color: var(--c-primary);
    font-weight: var(--fw-bold);
  }
</style>
