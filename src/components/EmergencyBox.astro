---
import { site } from '../config/site';
import { nbsp } from '../lib/format';
import Icon from './Icon.astro';
---

<aside class="emergency" aria-labelledby="emergency-title">
  <div class="emergency__icon"><Icon name="alert" size={28} /></div>
  <div>
    <h2 id="emergency-title" class="emergency__title">Problem mit der Zahnspange?</h2>
    <p>Während der telefonischen Erreichbarkeit helfen wir Ihnen direkt weiter:</p>
    <a class="emergency__phone" href={`tel:${site.phone.tel}`}>
      <Icon name="phone" size={26} />
      {nbsp(site.phone.display)}
    </a>
  </div>
</aside>

<style>
  .emergency {
    display: flex;
    gap: var(--sp-3);
    margin-bottom: var(--sp-5);
    padding: var(--sp-4);
    border-radius: var(--r-lg);
    background: var(--c-primary-soft);
    border: 2px solid var(--c-primary);
  }

  .emergency__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--c-primary);
    color: var(--c-on-primary);
  }

  .emergency__title {
    font-size: var(--fs-h3);
    margin-bottom: var(--sp-1);
  }

  .emergency__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--sp-1);
    font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.5rem);
    font-weight: var(--fw-bold);
    color: var(--c-primary-strong);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }

  .emergency__phone:hover {
    text-decoration: underline;
  }

  @media (max-width: 30rem) {
    .emergency {
      flex-direction: column;
      gap: var(--sp-2);
    }
  }
</style>
