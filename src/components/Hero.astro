---
import { Picture } from 'astro:assets';
import { url } from '../lib/url';
import { site } from '../config/site';
import { nbsp } from '../lib/format';
import Icon from './Icon.astro';

interface Props {
  eyebrow: string;
  title: string;
  text: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { eyebrow, title, text, image, imageAlt } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <Picture
    src={image}
    alt={imageAlt}
    class="hero__img"
    widths={[640, 960, 1280, 1920, 2400]}
    sizes="100vw"
    formats={['avif', 'webp']}
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="container hero__content">
    <p class="hero__eyebrow">{eyebrow}</p>
    <h1 id="hero-title">{title}</h1>
    <p class="hero__text">{text}</p>
    <div class="hero__actions">
      <a class="btn btn--light" href={url('/kontakt/')}>
        Kontakt
        <Icon name="arrowRight" />
      </a>
      <a class="btn btn--outline-light" href={`tel:${site.phone.tel}`}>
        <Icon name="phone" />
        {nbsp(site.phone.display)}
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: clamp(28rem, 72vh, 44rem);
    color: #ffffff;
    isolation: isolate;
    overflow: hidden;
  }

  .hero > :global(picture),
  .hero__overlay {
    grid-area: 1 / 1;
  }

  .hero :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero > :global(picture) {
    z-index: -2;
  }

  .hero__overlay {
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(26 22 21 / 0.82) 0%, rgb(26 22 21 / 0.6) 45%, rgb(26 22 21 / 0.15) 100%),
      linear-gradient(0deg, rgb(26 22 21 / 0.35), transparent 40%);
  }

  .hero__content {
    grid-area: 1 / 1;
    align-self: center;
    padding-block: var(--sp-8);
  }

  .hero__eyebrow {
    display: inline-flex;
    margin-bottom: var(--sp-2);
    padding: 0.35rem 0.85rem;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.14);
    border: 1px solid rgb(255 255 255 / 0.3);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    letter-spacing: 0.04em;
  }

  h1 {
    max-width: 16ch;
    font-size: clamp(2.25rem, 1.5rem + 3.2vw, 4rem);
    color: #ffffff;
  }

  .hero__text {
    max-width: 36rem;
    font-size: var(--fs-lg);
    color: rgb(255 255 255 / 0.92);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-4);
  }

  .hero__actions .btn {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 40rem) {
    .hero__overlay {
      background: linear-gradient(0deg, rgb(26 22 21 / 0.85) 0%, rgb(26 22 21 / 0.65) 60%, rgb(26 22 21 / 0.45) 100%);
    }
  }
</style>
