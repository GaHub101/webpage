---
interface Props {
  steps: Array<{ title: string; text: string }>;
  title?: string;
}

const { steps, title = 'Ablauf' } = Astro.props;
---

<section class="steps" aria-labelledby="steps-title">
  <h2 id="steps-title">{title}</h2>
  <ol class="steps__list">
    {
      steps.map((step) => (
        <li class="steps__item">
          <h3 class="steps__title">{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .steps {
    margin-bottom: var(--sp-6);
  }

  .steps__list {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
  }

  .steps__item {
    counter-increment: step;
    position: relative;
    padding: var(--sp-3) var(--sp-3) var(--sp-2) calc(var(--sp-3) + 3.25rem);
    background: var(--c-bg-warm);
    border-radius: var(--r-md);
  }

  .steps__item::before {
    content: counter(step);
    position: absolute;
    left: var(--sp-3);
    top: var(--sp-3);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--c-primary);
    color: var(--c-on-primary);
    font-weight: var(--fw-bold);
  }

  .steps__title {
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .steps__item p {
    margin-bottom: var(--sp-1);
    color: var(--c-text-muted);
  }
</style>
