---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import Icon from './Icon.astro';

// Logos werden nur angezeigt, wenn in site.ts ein Dateiname gesetzt ist.
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/images/logos/*.{svg,png,jpg,webp}', { eager: true });
const logoFor = (file?: string) => (file ? logos[`../assets/images/logos/${file}`]?.default : undefined);
---

<ul class="memberships">
  {
    site.memberships.map((m) => {
      const logo = logoFor(m.logo);
      return (
        <li>
          <a href={m.url} rel="noopener" target="_blank" class="memberships__link">
            {logo ? <Image src={logo} alt="" height={48} class="memberships__logo" /> : null}
            <span>{m.name}</span>
            <Icon name="external" size={16} />
            <span class="visually-hidden">(öffnet in neuem Fenster)</span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .memberships {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .memberships__link {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    height: 100%;
    min-height: 72px;
    padding: var(--sp-2) var(--sp-3);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-surface);
    color: var(--c-text);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .memberships__link:hover {
    color: var(--c-primary-strong);
    border-color: var(--c-primary);
    background: var(--c-surface-hover);
  }

  .memberships__link :global(svg) {
    flex: none;
    margin-left: auto;
    color: var(--c-text-muted);
  }

  .memberships__link :global(.memberships__logo) {
    width: auto;
    height: 40px;
    flex: none;
  }
</style>
