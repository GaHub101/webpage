# Kopieren nach .env (wird nicht eingecheckt) und anpassen.

# Öffentliche Adresse der Website (ohne Pfad)
SITE_URL=http://localhost:4321
# Unterordner, unter dem die Website liegt. GitHub Pages: /webpage/  · eigene Domain: /
BASE_PATH=/

# true = Suchmaschinen aussperren (Testumgebung)
PUBLIC_NOINDEX=true

# Kontaktformular: demo | cloudflare | php
PUBLIC_FORM_MODE=demo
# Öffentlicher Turnstile-Site-Key (nur für cloudflare/php). Der geheime Schlüssel gehört NIE hierher.
PUBLIC_TURNSTILE_SITEKEY=
